{
  "description": "Deny an AskUserQuestion call whose option labels break the right-stuff marker rules",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/check-ask-markers.py"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
