{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rubicon/ai-skills/plugins/salience/config/identity.schema.json",
  "title": "Salience Professional Identity Record",
  "description": "The user's career record and fact ledger. Stored outside the repository in the private local store. Never committed.",
  "type": "object",
  "required": ["version", "person", "facts"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "updated": { "type": "string", "format": "date" },

    "person": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "headline_name": { "type": "string", "description": "Name as it should appear in copy, if different" },
        "location": { "type": "string" },
        "relocation_open": { "type": "boolean" },
        "remote_open": { "type": "boolean" },
        "linkedin_url": { "type": "string" },
        "website": { "type": "string" },
        "pronouns": { "type": "string" }
      }
    },

    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "organization", "start"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string", "description": "Verbatim title as held" },
          "title_standard": { "type": "string", "description": "Industry-standard equivalent when the internal title was idiosyncratic. Never overwrites 'title'." },
          "organization": { "type": "string" },
          "organization_former_names": { "type": "array", "items": { "type": "string" } },
          "employment_type": { "type": "string", "enum": ["full-time", "part-time", "contract", "fractional", "advisory", "board", "founder", "volunteer"] },
          "start": { "type": "string", "pattern": "^[0-9]{4}(-[0-9]{2})?$" },
          "end": { "type": ["string", "null"], "pattern": "^[0-9]{4}(-[0-9]{2})?$" },
          "date_precision": { "type": "string", "enum": ["month", "year"], "default": "month" },
          "location": { "type": "string" },
          "scope": {
            "type": "object",
            "description": "Executive scope. Absence is a gap, not a zero.",
            "additionalProperties": false,
            "properties": {
              "team_size": { "type": "integer" },
              "budget": { "type": "string" },
              "revenue_influenced": { "type": "string" },
              "pnl_owned": { "type": "boolean" },
              "reports_to": { "type": "string" },
              "geography": { "type": "string" },
              "business_units": { "type": "integer" }
            }
          }
        }
      }
    },

    "facts": {
      "type": "array",
      "description": "The fact ledger. Every professional claim Salience may use.",
      "items": {
        "type": "object",
        "required": ["id", "claim", "tier"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "claim": { "type": "string" },
          "tier": { "type": "string", "enum": ["verified", "stated", "inferred", "proposed"] },
          "source": { "type": "string", "description": "Required when tier is 'verified'." },
          "recorded": { "type": "string", "format": "date" },
          "role_id": { "type": "string" },
          "period": { "type": "string" },
          "context": { "type": "string", "enum": ["employer-side", "client-side"] },
          "subject": {
            "type": "string",
            "enum": ["self", "organization"],
            "description": "Whose achievement this is. Absent means 'self'. 'organization' marks a fact that is true and sourced but belongs to the company, not the person — publishing it as a personal achievement is an overclaim, not a stronger claim."
          },
          "attribution": {
            "type": "string",
            "enum": ["personal", "led-team"],
            "description": "How much of it was the user. Only meaningful when subject is 'self'."
          },
          "visibility": {
            "type": "string",
            "enum": ["public", "shared", "private"],
            "description": "Where this fact may appear. Absent means 'public'. 'shared' permits a sent resume or a private conversation but not a public profile. 'private' means it never leaves the record — a quarantined figure, regardless of how well sourced it is."
          },
          "visibility_reason": {
            "type": "string",
            "description": "Required when visibility is 'private'. Why it is quarantined, so the restriction survives the person who set it."
          },
          "metric": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "value": { "type": "string" },
              "unit": { "type": "string" },
              "period": { "type": "string" },
              "scope": { "type": "string" }
            }
          },
          "used_in": { "type": "array", "items": { "type": "string" }, "description": "Published surfaces repeating this claim, so corrections can be propagated." },
          "superseded_by": { "type": ["string", "null"] },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "claim": { "type": "string" },
                "source": { "type": "string" },
                "superseded": { "type": "string", "format": "date" },
                "reason": { "type": "string" }
              }
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "tier": { "const": "verified" } }, "required": ["tier"] },
            "then": { "required": ["source"] }
          },
          {
            "if": { "properties": { "subject": { "const": "organization" } }, "required": ["subject"] },
            "then": { "not": { "required": ["attribution"] } }
          },
          {
            "if": { "properties": { "visibility": { "const": "private" } }, "required": ["visibility"] },
            "then": { "required": ["visibility_reason"] }
          }
        ]
      }
    },

    "gaps": {
      "type": "array",
      "description": "Known missing evidence. A gap is a request to the user, never a claim to a reader.",
      "items": {
        "type": "object",
        "required": ["id", "wants"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "wants": { "type": "string" },
          "why": { "type": "string" },
          "blocks": { "type": "array", "items": { "type": "string" } },
          "asked": { "type": "string", "format": "date" },
          "resolved": { "type": ["string", "null"], "format": "date" }
        }
      }
    },

    "targets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "roles": { "type": "array", "items": { "type": "string" } },
        "company_profile": { "type": "string" },
        "industries": { "type": "array", "items": { "type": "string" } },
        "audiences": { "type": "array", "items": { "type": "string" } },
        "consulting_in_scope": { "type": "boolean" },
        "compensation_floor": { "type": "string" },
        "deal_breakers": { "type": "array", "items": { "type": "string" } }
      }
    },

    "boundaries": {
      "type": "object",
      "description": "What the user will not claim or be pitched for. Enforced by every module.",
      "additionalProperties": false,
      "properties": {
        "will_not_claim": { "type": "array", "items": { "type": "string" } },
        "will_not_be_pitched_for": { "type": "array", "items": { "type": "string" } },
        "confidential_clients": { "type": "array", "items": { "type": "string" }, "description": "Never named publicly; anonymize in all output. Client-level. A per-fact prohibition uses the fact's own 'visibility' field instead." }
      }
    },

    "expertise": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["area"],
        "additionalProperties": false,
        "properties": {
          "area": { "type": "string" },
          "depth": { "type": "string", "enum": ["core", "strong", "working", "familiar"] },
          "evidence": { "type": "array", "items": { "type": "string" }, "description": "Fact ids supporting this." }
        }
      }
    }
  }
}
